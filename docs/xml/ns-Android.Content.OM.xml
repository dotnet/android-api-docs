<Namespace Name="Android.Content.OM">
  <Docs>
    <summary>Provides types to identify, describe, and manage runtime resource overlays.</summary>
    <remarks>
      <para>Use <see cref="T:Android.Content.OM.FabricatedOverlay" /> to define overlay resource values, <see cref="T:Android.Content.OM.OverlayIdentifier" /> to identify an overlay, and <see cref="T:Android.Content.OM.OverlayInfo" /> to read overlay information. <see cref="T:Android.Content.OM.OverlayManager" /> and <see cref="T:Android.Content.OM.OverlayManagerTransaction" /> provide overlay management operations.</para>
      <para>
        <format type="text/html">
          <a href="https://developer.android.com/reference/android/content/om/package-summary">Android overlay management package</a>.
        </format>
      </para>
    </remarks>
  </Docs>
</Namespace>
