          <AttributeName Language="F#">[&lt;Android.Runtime.IntDefinition("Android.Content.PM.ServiceInfo.FlagUseAppZygote", JniField="android/content/pm/ServiceInfo.FLAG_USE_APP_ZYGOTE")&gt;]</AttributeName>
