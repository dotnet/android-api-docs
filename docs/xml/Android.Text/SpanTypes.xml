    <Member MemberName="Paragraph">
      <MemberSignature Language="C#" Value="Paragraph" />
      <MemberSignature Language="ILAsm" Value=".field public static literal valuetype Android.Text.SpanTypes Paragraph = int32(51)" />
      <MemberSignature Language="DocId" Value="F:Android.Text.SpanTypes.Paragraph" />
