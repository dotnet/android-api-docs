          <AttributeName Language="F#">[&lt;Android.Runtime.Register("login", "(Ljavax/security/auth/Subject;Ljavax/security/auth/callback/CallbackHandler;)V", "GetLogin_Ljavax_security_auth_Subject_Ljavax_security_auth_callback_CallbackHandler_Handler")&gt;]</AttributeName>
