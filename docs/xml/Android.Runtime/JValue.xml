      <Parameters>
        <Parameter Name="value" Type="Android.Runtime.IJavaObject" />
      </Parameters>
      <Docs>
        <param name="value">
            The Java object instance. If <see langword="null" />, the resulting
            <see cref="T:Android.Runtime.JValue" /> will contain <see cref="F:System.IntPtr.Zero" />.
            </param>
        <summary>
            Creates a <see cref="T:Android.Runtime.JValue" /> from an <see cref="T:Android.Runtime.IJavaObject" /> instance,
            corresponding to a JNI <c>jobject</c> reference.
            </summary>
        <remarks>
            This constructor extracts the <see cref="P:Android.Runtime.IJavaObject.Handle" /> from the
            provided object, or passes <see cref="F:System.IntPtr.Zero" /> if the object is <see langword="null" />.
            </remarks>
      </Docs>
    </Member>
